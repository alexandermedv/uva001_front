# Set version python 
FROM nexus.dp.pgk.ru/python:3.11
LABEL maintainer "Турганов Артем TurganovAI@pgkweb.ru"

# set workdir directory
WORKDIR /usr/src/app

# set TZ Moscow time
ENV TZ Europe/Moscow

# ADD /drivers/tzdata_2021a-1+deb11u2_all.deb /opt
# RUN apt-get install tzdata
# RUN dpkg -i /opt/tzdata_2021a-1+deb11u2_all.deb

# install system dependencies
# RUN pip install --upgrade pip
# copy requirements and projects 

RUN cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ >/etc/timezone 

COPY . /usr/src/app/  

# AT pip nexus
COPY pip.conf .
ENV PIP_CONFIG_FILE pip.conf
RUN pip install -r requirement_sas13_tstdb_p311.txt

# install necessary python modules
# RUN pip install --proxy=http://msc01-cfw01.pgk.rzd:9090 -r requirements.txt

# copy entrypoint.sh
# COPY ./entrypoint.sh /opt/restapi/entrypoint.sh

USER root

RUN sed -i 's/providers = provider_sect/providers = provider_sect\n\
ssl_conf = ssl_sect\n\
\n\
[ssl_sect]\n\
system_default = system_default_sect\n\
\n\
[system_default_sect]\n\
Options = UnsafeLegacyRenegotiation/' /etc/ssl/openssl.cnf

EXPOSE 7249
# EXPOSE {FLASK_PORT_PROD}